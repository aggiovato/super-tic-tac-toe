# Response headers for the static app (Cloudflare Workers static assets, same format as Netlify).
# Hashed build output never changes under the same name: cache it for a year. Only names no
# service worker file shares (`worker-*.js` would also match `worker-basic.min.js`, which must be
# revalidated): the opponents' Workers keep Netlify's default revalidation, and the service worker
# caches them for offline play anyway.
/main-*.js
  Cache-Control: public, max-age=31536000, immutable
/chunk-*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# The web app manifest, with its registered type.
/manifest.webmanifest
  Content-Type: application/manifest+json

# The shell must always be revalidated so a new release is picked up at once.
/index.html
  Cache-Control: no-cache

# The service worker and its manifest: revalidated on every check, so a release reaches installed
# copies of the app.
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
