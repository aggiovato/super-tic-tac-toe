{
  "name": "super-tic-tac-toe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint . --max-warnings=0 && node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:core": "npm run typecheck:core && vitest run --config vitest.core.config.mts --coverage",
    "test:app": "ng test --watch=false",
    "test": "npm run test:core && npm run test:app",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@ngrx/signals": "22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.3",
    "jsdom": "^30.0.0",
    "postcss": "8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  }
}
