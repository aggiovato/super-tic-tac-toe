{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@tictac": ["./src/app/games/tictac/index.ts"],
      "@super3t/core": ["./src/app/games/super-3t/core/index.ts"],
      "@super3t/core/testing": ["./src/app/games/super-3t/core/testing/index.ts"],
      "@super3t/ai": ["./src/app/games/super-3t/ai/index.ts"],
      "@super3t/challenge": ["./src/app/games/super-3t/challenge/index.ts"],
      "@super3t/session": ["./src/app/games/super-3t/session/index.ts"],
      "@super3t/state": ["./src/app/games/super-3t/state/index.ts"],
      "@super3t/ui": ["./src/app/games/super-3t/ui/index.ts"],
      "@match": ["./src/app/match/index.ts"],
      "@shell": ["./src/app/shell/index.ts"],
      "@classic/core": ["./src/app/games/classic/core/index.ts"],
      "@classic/ai": ["./src/app/games/classic/ai/index.ts"],
      "@classic/session": ["./src/app/games/classic/session/index.ts"],
      "@classic/state": ["./src/app/games/classic/state/index.ts"],
      "@classic/ui": ["./src/app/games/classic/ui/index.ts"],
      "@history": ["./src/app/history/index.ts"],
      "@storage": ["./src/app/storage/index.ts"],
      "@i18n": ["./src/app/i18n/index.ts"],
      "@settings": ["./src/app/settings/index.ts"],
      "@kit": ["./src/app/kit/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.core.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    },
    {
      "path": "./tsconfig.worker.json"
    }
  ]
}
