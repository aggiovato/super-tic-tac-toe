{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@tictac": ["./src/engine/tictac/index.ts"],
      "@super3t/core": ["./src/engine/super-3t/core/index.ts"],
      "@super3t/core/testing": ["./src/engine/super-3t/core/testing/index.ts"],
      "@super3t/ai": ["./src/engine/super-3t/ai/index.ts"],
      "@super3t/challenge": ["./src/engine/super-3t/challenge/index.ts"],
      "@super3t/session": ["./src/app/features/games/super-3t/session/index.ts"],
      "@super3t/state": ["./src/app/features/games/super-3t/state/index.ts"],
      "@super3t/ui": ["./src/app/features/games/super-3t/ui/index.ts"],
      "@super3t/ui/preview": ["./src/app/features/games/super-3t/ui/preview/index.ts"],
      "@match": ["./src/app/core/match/index.ts"],
      "@layout": ["./src/app/layout/index.ts"],
      "@classic/core": ["./src/engine/classic/core/index.ts"],
      "@classic/ai": ["./src/engine/classic/ai/index.ts"],
      "@classic/session": ["./src/app/features/games/classic/session/index.ts"],
      "@classic/state": ["./src/app/features/games/classic/state/index.ts"],
      "@classic/ui": ["./src/app/features/games/classic/ui/index.ts"],
      "@classic/ui/preview": ["./src/app/features/games/classic/ui/preview/index.ts"],
      "@dots/core": ["./src/engine/dots/core/index.ts"],
      "@dots/ai": ["./src/engine/dots/ai/index.ts"],
      "@dots/session": ["./src/app/features/games/dots/session/index.ts"],
      "@dots/state": ["./src/app/features/games/dots/state/index.ts"],
      "@dots/ui": ["./src/app/features/games/dots/ui/index.ts"],
      "@dots/ui/preview": ["./src/app/features/games/dots/ui/preview/index.ts"],
      "@storage": ["./src/app/core/storage/index.ts"],
      "@i18n": ["./src/app/core/i18n/index.ts"],
      "@preferences": ["./src/app/core/preferences/index.ts"],
      "@catalog": ["./src/engine/catalog/index.ts"],
      "@library": ["./src/app/features/library/index.ts"],
      "@history": ["./src/app/features/history/index.ts"],
      "@pwa": ["./src/app/core/pwa/index.ts"],
      "@ui": ["./src/app/ui/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.core.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    },
    {
      "path": "./tsconfig.worker.json"
    }
  ]
}
