/* @tictac and every game's engine, opponent and challenges: plain TypeScript, no Angular or DOM. Used by Vitest in Node (npm run test:core). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2022"]
  },
  "include": [
    "src/app/games/tictac/**/*.ts",
    "src/app/games/catalog/**/*.ts",
    "src/app/games/*/core/**/*.ts",
    "src/app/games/*/ai/**/*.ts",
    "src/app/games/*/challenge/**/*.ts",
    "vitest.core.config.mts"
  ]
}
